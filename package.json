{
  "name": "filesystem-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing scoped filesystem operations (list, stat, read, glob, and optional move/copy/delete) for media library organization and similar use cases. Path-whitelisted, deny-pattern-aware, dry-run-by-default writes.",
  "type": "module",
  "bin": {
    "filesystem-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "express": "^4.21.0",
    "picomatch": "^4.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/express": "^4.17.0",
    "@types/node": "^22.0.0",
    "@types/picomatch": "^4.0.3",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=22"
  }
}
