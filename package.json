{
  "name": "@carldog/filesystem-mcp",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "MCP server exposing scoped filesystem operations (list, stat, read, glob, and optional move/copy/delete) for media library organization and similar use cases. Path-whitelisted, deny-pattern-aware, dry-run-by-default writes.",
  "type": "module",
  "bin": {
    "filesystem-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^4.21.0",
    "picomatch": "^4.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.0",
    "@types/node": "^26.0.0",
    "@types/picomatch": "^4.0.3",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "npm@11.19.0"
}
