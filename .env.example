# Optional: comma-separated absolute paths the MCP is allowed to operate on.
# Every tool resolves its input path (including symlinks) and refuses anything
# outside these roots.
#
# When unset, roots are DERIVED from the container-side targets of the
# FS_VOLUME* bind specs below (so /volume1/Media:/media:ro → root /media).
# Declare each mount once and the roots follow. Set FS_ROOTS explicitly only
# to NARROW below the full mount list (e.g. expose a subtree of a mount).
#
# For `npm run dev` (no compose, no FS_VOLUME*), set this to a sandbox dir.
# FS_ROOTS=/media

# Optional: enable mutation tools (move/copy/delete/mkdir). Default false.
# Read tools work regardless. Strongly recommend leaving false until the dev
# chat has finished implementing dry-run mode and reviewed each write tool.
FS_ALLOW_WRITE=false

# Optional: glob patterns matched against basenames; matched files are
# excluded from list/read results and rejected for any operation. Default
# covers common sensitive files. Empty value disables the deny-pattern.
FS_DENY_FILE_PATTERNS=*.env,*.key,*.pem,*.pfx,*.p12,id_rsa*,id_dsa*,id_ecdsa*,id_ed25519*,known_hosts,authorized_keys,.htpasswd,*.kdbx

# Optional: cap on bytes returned by fs_read_file (per call). Default 1 MiB.
# 0 disables the cap (NOT recommended; large files will fill the LLM context).
FS_MAX_READ_BYTES=1048576

# Optional: cap on entries returned by fs_list_directory. Default 1000.
FS_MAX_LIST_ENTRIES=1000

# MCP transport — set MCP_PORT to enable HTTP transport (long-lived deploy).
# Unset = stdio mode (`docker run -i ...`).
# MCP_PORT=3000

# Docker compose only — host:container[:flags] bind specs.
# FS_VOLUME is required when deploying via docker-compose (ignored by
# `npm run dev`); compose fails loudly if unset. FS_VOLUME_2 and
# FS_VOLUME_3 are optional additional bind specs; when unset they
# default to a no-op /dev/null:/dev/null:ro sentinel mount.
#
# These targets also become the default FS_ROOTS (see above) — so with
# the example below, roots default to /media and /docker. To expose only
# the portainer-ce subtree of the /docker mount, set FS_ROOTS=/media,/docker/portainer-ce.
# FS_VOLUME=/volume1/Media:/media:ro
# FS_VOLUME_2=/volume1/docker:/docker:ro
# FS_VOLUME_3=
