# Required: comma-separated absolute paths the MCP is allowed to operate on.
# Every tool resolves its input path (including symlinks) and refuses anything
# outside these roots. Set to your media library root(s).
FS_ROOTS=/media

# Optional: enable mutation tools (move/copy/delete/mkdir). Default false.
# Read tools work regardless. Strongly recommend leaving false until the dev
# chat has finished implementing dry-run mode and reviewed each write tool.
FS_ALLOW_WRITE=false

# Optional: glob patterns matched against basenames; matched files are
# excluded from list/read results and rejected for any operation. Default
# covers common sensitive files. Empty value disables the deny-pattern.
FS_DENY_FILE_PATTERNS=*.env,*.key,*.pem,*.pfx,*.p12,id_rsa*,id_dsa*,id_ecdsa*,id_ed25519*,known_hosts,authorized_keys,.htpasswd,*.kdbx

# Optional: cap on bytes returned by fs_read_file (per call). Default 1 MiB.
# 0 disables the cap (NOT recommended; large files will fill the LLM context).
FS_MAX_READ_BYTES=1048576

# Optional: cap on entries returned by fs_list_directory. Default 1000.
FS_MAX_LIST_ENTRIES=1000

# MCP transport — set MCP_PORT to enable HTTP transport (long-lived deploy).
# Unset = stdio mode (`docker run -i ...`).
# MCP_PORT=3000
