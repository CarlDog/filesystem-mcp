# Default: detect text files automatically; normalize to LF in the repo.
* text=auto

# Shell scripts and pre-commit hooks MUST stay LF on every platform
# (Git Bash on Windows can choke on CRLF in scripts).
*.sh        text eol=lf
.githooks/* text eol=lf

# Windows-specific scripts stay CRLF.
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Lockfiles are large and noisy in diffs; mark for exclusion from
# regular diffs but keep merging.
package-lock.json -diff
